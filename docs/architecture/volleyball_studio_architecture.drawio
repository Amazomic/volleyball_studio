metry"/></mxCell><mxCell id="subtext" value="Ссылки между версиями: GPU результаты неизменяемые, CPU результаты независимые. Файлы здесь не обозначают новые модели." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#526781;" vertex="1" parent="1"><mxGeometry x="85" y="102" width="1356" height="57" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt; — исполнение   - - чтение данных   ··· условная / необязательная ветка   |   Схема отражает локальный код Rust, включая незакоммиченные изменения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#587087;" vertex="1" parent="1"><mxGeometry x="85" y="167" width="1356" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=5;fillColor=#e2eeff;strokeColor=#5c94df;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="430" height="936" as="geometry"/></mxCell><mxCell id="lane_title0" value="&lt;b&gt;GPU-КЭШ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#153b74;" vertex="1" parent="1"><mxGeometry x="102" y="235" width="405" height="40" as="geometry"/></mxCell><mxCell id="node_a0" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;native_gpu_runs/&amp;lt;ball_id&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;detections.jsonl + manifest.json&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#153b74;fillColor=#e2eeff;strokeColor=#5c94df;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="99" y="282" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_a1" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;native_gpu_runs/&amp;lt;players_id&amp;gt;&lt;/div&gt;&lt;d