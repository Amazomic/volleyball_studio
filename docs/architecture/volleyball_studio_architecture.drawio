yle=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Проверка профиля + identity_revision&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#1b6540;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="729" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_d04" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;GPU версия совпала?&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Анализ уже сохранён&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#1b6540;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="878" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_d05" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Нет совпадений&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Запуск ONNX/CUDA&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#1b6540;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="1027" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_d06" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Поза включена?&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;RTMPose в GPU или проверка сохранённой позы&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#1b6540;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="1176" width="402" height="10