:16px;font-weight:bold&quot;&gt;evaluate_pose_block&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Доп. motion-backed contact candidates&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#734a0a;fillColor=#fff1d8;strokeColor=#dc9f32;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="1325" width="402" height="107" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=5;fillColor=#fff1d8;strokeColor=#dc9f32;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="1011" y="230" width="430" height="1383" as="geometry"/></mxCell><mxCell id="lane_title2" value="&lt;b&gt;ВЕТВЛЕНИЯ АЛГОРИТМОВ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#734a0a;" vertex="1" parent="1"><mxGeometry x="1028" y="235" width="405" height="40" as="geometry"/></mxCell><mxCell id="node_b0" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;algorithm = PoseMotion&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Строгий: траектория + тело (название UI)&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#734a0a;fillColor=#fff1d8;strokeColor=#dc9f32;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1025" y="282" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_b1" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;PoseMotion → motion base&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;evaluate_rally_blocks&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#734a0a;fillColor=#fff1d8;strokeColor=#dc9f32;strokeWidth=2;shadow=0;" ver