;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#153b74;fillColor=#e2eeff;strokeColor=#5c94df;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="1474" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_g_save" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Неизменяемый GPU snapshot&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;fusion + raw + poses; SHA-256&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#153b74;fillColor=#e2eeff;strokeColor=#5c94df;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="562" y="1623" width="402" height="107" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=5;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="1011" y="230" width="430" height="1532" as="geometry"/></mxCell><mxCell id="lane_title2" value="&lt;b&gt;CPU: ТРЕКИ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#1b6540;" vertex="1" parent="1"><mxGeometry x="1028" y="235" width="405" height="40" as="geometry"/></mxCell><mxCell id="node_t_load" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Чтение fusion + poses&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;Только сохранённые GPU-артефакты&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#1b6540;fillColor=#e0f5e8;strokeColor=#57ad7a;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1025" y="282" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_t_assoc" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Назначение временных Track ID&lt;/div&gt;