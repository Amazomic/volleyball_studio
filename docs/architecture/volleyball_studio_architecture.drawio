><mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2452" pageHeight="1706"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="maintitle" value="&lt;b&gt;VOLLEYBALL STUDIO · 02 · GPU: реальные входы&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#243852;" vertex="1" parent="1"><mxGeometry x="85" y="40" width="2282" height="52" as="geometry"/></mxCell><mxCell id="subtext" value="Первичный GPU: Windows и Unix имеют разные схемы декодирования. RF-DETR делает direct resize до 576² без letterbox; RTMPose извлекает пиксели из оригинала." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#526781;" vertex="1" parent="1"><mxGeometry x="85" y="102" width="2282" height="57" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt; — исполнение   - - чтение данных   ··· условная / необязательная ветка   |   Схема отражает локальный код Rust, включая незакоммиченные изменения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#587087;" vertex="1" parent="1"><mxGeometry x="85" y="167" width="2282" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=5;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="430" height="1383" as="geometry"/></mxCell><mxCell id="lane_title0" value="&lt;b&gt;ВИДЕО / ДЕКОДЕР&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#17375a;" vertex="1" parent="1"><mxGeometry x="102" y="235" width="405" height="40" as="geometry"/></mxCell><mxCell id="node_v0" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Оригинальный файл&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586