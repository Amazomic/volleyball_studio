raphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1989" pageHeight="1408"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="maintitle" value="&lt;b&gt;VOLLEYBALL STUDIO · 03 · CPU: Track ID&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#243852;" vertex="1" parent="1"><mxGeometry x="85" y="40" width="1819" height="52" as="geometry"/></mxCell><mxCell id="subtext" value="Два прохода трекинга: сначала временные ID и подтверждения, затем фильтрация. Склейка дублей и turnover происходят ДО интерполяции." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#526781;" vertex="1" parent="1"><mxGeometry x="85" y="102" width="1819" height="57" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt; — исполнение   - - чтение данных   ··· условная / необязательная ветка   |   Схема отражает локальный код Rust, включая незакоммиченные изменения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#587087;" vertex="1" parent="1"><mxGeometry x="85" y="167" width="1819" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=5;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="430" height="1085" as="geometry"/></mxCell><mxCell id="lane_title0" value="&lt;b&gt;ПРОВЕРЕННЫЕ ДАННЫЕ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#17375a;" vertex="1" parent="1"><mxGeometry x="102" y="235" width="405" height="40" as="geometry"/></mxCell><mxCell id="node_q0" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;GPU fusion manifest&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;frames.jsonl, 30 FPS, SHA-256&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#17375a;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="99" y="282" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_q1" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Источник pose run&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;native_gpu_pose_runs / poses.jsonl&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#17375a;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="99" y="431" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_q2" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Проверка source identity&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;original provenance, bytes/mtime&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#17375a;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="99" y="580" width="402" height="107" as="geometry"/></mxCell><mxCell id="node_q3" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;CPU TrackingOptions&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#586f85;margin-top:5px&quot;&gt;min_score, NMS, gap, min observations&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=15;fontColor=#17375a;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="99" y="729" width="402" height="107" as="geometry"/></mxCell><mxCell id="node