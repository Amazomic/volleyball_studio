<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" version="24.7.17" type="device" modified="2026-11-18T02:45:00Z" agent="volleyball-studio-source-audit"><diagram id="arch0" name="00 · Полный поток"><mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2915" pageHeight="1855"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="maintitle" value="&lt;b&gt;VOLLEYBALL STUDIO · 00 · Полный поток&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#243852;" vertex="1" parent="1"><mxGeometry x="85" y="40" width="2745" height="52" as="geometry"/></mxCell><mxCell id="subtext" value="Фактическая последовательность вызовов studio_pipeline.rs. Не одно нейросетевое действие, а отдельные стадии и артефакты. Пунктир — чтение данных или условная ветка." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#526781;" vertex="1" parent="1"><mxGeometry x="85" y="102" width="2745" height="57" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt; — исполнение   - - чтение данных   ··· условная / необязательная ветка   |   Схема отражает локальный код Rust, включая незакоммиченные изменения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#587087;" vertex="1" parent="1"><mxGeometry x="85" y="167" width="2745" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=5;fillColor=#edf3fc;strokeColor=#8aa9d1;strokeWidth=1;opacity=18;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="430" height="1532" as="geometry"/></mxCell><mxCell id="lane_title0" value="&lt;b&gt;ПРОЕКТ / ИСХОДНИК&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#17375a;" vertex="1" parent="1"><mxGeometry x="10